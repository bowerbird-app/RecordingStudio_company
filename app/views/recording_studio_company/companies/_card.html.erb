<%# locals: (company:) %>
<% record = company.recordable %>
<% website_href = record.website_href %>
<%= render FlatPack::Card::Component.new(style: :default) do |card| %>
  <% card.body do %>
    <div class="flex flex-col gap-4" data-recording-studio-company-card>
      <div class="flex items-center gap-4">
        <%= recording_studio_company_logo(company, size: :xl) %>
        <%= render FlatPack::SectionTitle::Component.new(
          title: record.name,
          size: :md,
          spacing: :none,
          level: :h3,
          class: "min-w-0"
        ) %>
      </div>

      <% if record.description.present? %>
        <p class="whitespace-pre-line text-sm leading-6"><%= record.description %></p>
      <% end %>

      <% if record.website_url.present? %>
        <dl class="grid gap-3 text-sm sm:grid-cols-2">
          <div>
            <dt class="text-(--surface-muted-content-color)"><%= t("recording_studio.company.labels.website") %></dt>
            <dd class="break-words">
              <% if website_href %>
                <%= render FlatPack::Link::Component.new(
                  href: website_href,
                  target: "_blank",
                  rel: "noopener noreferrer",
                  class: "break-words"
                ) do %>
                  <%= record.website_url %>
                <% end %>
              <% else %>
                <%= record.website_url %>
              <% end %>
            </dd>
          </div>
        </dl>
      <% end %>
    </div>
  <% end %>
<% end %>

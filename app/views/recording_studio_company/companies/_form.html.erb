<%# locals: (record:, url:, form_method:, submit_text:, cancel_url:, idempotency_key: nil, unsaved_changes: false) %>
<% limits = RecordingStudioCompany::Company::LIMITS %>
<% form_data = unsaved_changes ? { controller: "flat-pack--unsaved-changes" } : {} %>
<%= form_with url: url, method: form_method, class: "flex max-w-2xl flex-col gap-4", data: form_data do %>
  <% if idempotency_key %>
    <%= hidden_field_tag :idempotency_key, idempotency_key, id: nil %>
  <% end %>

  <% if record.errors.any? %>
    <%= render FlatPack::Alert::Component.new(
      style: :danger,
      title: "The company could not be saved",
      description: record.errors.full_messages.to_sentence
    ) %>
  <% end %>

  <%= render FlatPack::TextInput::Component.new(
    name: "company[name]",
    value: record.name,
    label: "Name",
    required: true,
    maxlength: limits[:name],
    error: company_field_error(record, :name)
  ) %>

  <%= render FlatPack::UrlInput::Component.new(
    name: "company[website_url]",
    value: record.website_url,
    label: "Website",
    placeholder: "https://example.com",
    maxlength: limits[:website_url],
    error: company_field_error(record, :website_url)
  ) %>

  <%= render FlatPack::TextArea::Component.new(
    name: "company[description]",
    value: record.description,
    label: "Description",
    rows: 4,
    maxlength: limits[:description],
    error: company_field_error(record, :description)
  ) %>

  <div class="flex flex-wrap gap-3">
    <% if unsaved_changes %>
      <%= render FlatPack::Button::Component.new(
        text: submit_text,
        style: :default,
        type: "submit",
        data: { "flat-pack--unsaved-changes-target": "submit" }
      ) %>
    <% else %>
      <%= render FlatPack::Button::Component.new(text: submit_text, style: :primary, type: "submit") %>
    <% end %>
    <%= render FlatPack::Button::Component.new(text: "Cancel", style: :ghost, href: cancel_url) %>
  </div>
<% end %>

<%# locals: (record:, url:, form_method:, submit_text:, cancel_url:, idempotency_key: nil) %>
<% limits = RecordingStudioCompany::Company::LIMITS %>
<%= form_with url: url, method: form_method, class: "flex max-w-2xl flex-col gap-4" do %>
  <% if idempotency_key %>
    <%= hidden_field_tag :idempotency_key, idempotency_key, id: nil %>
  <% end %>

  <% if record.errors.any? %>
    <%= render FlatPack::Alert::Component.new(
      style: :danger,
      title: "The company could not be saved",
      description: record.errors.full_messages.to_sentence
    ) %>
  <% end %>

  <%= render FlatPack::TextInput::Component.new(
    name: "company[name]",
    value: record.name,
    label: "Name",
    required: true,
    maxlength: limits[:name],
    error: company_field_error(record, :name)
  ) %>

  <%= render FlatPack::TextInput::Component.new(
    name: "company[legal_name]",
    value: record.legal_name,
    label: "Legal name",
    help_text: "The registered name, if it differs.",
    maxlength: limits[:legal_name],
    error: company_field_error(record, :legal_name)
  ) %>

  <%= render FlatPack::TextArea::Component.new(
    name: "company[description]",
    value: record.description,
    label: "Description",
    rows: 4,
    maxlength: limits[:description],
    error: company_field_error(record, :description)
  ) %>

  <%= render FlatPack::UrlInput::Component.new(
    name: "company[website_url]",
    value: record.website_url,
    label: "Website",
    placeholder: "https://example.com",
    maxlength: limits[:website_url],
    error: company_field_error(record, :website_url)
  ) %>

  <%= render FlatPack::EmailInput::Component.new(
    name: "company[email]",
    value: record.email,
    label: "Email",
    maxlength: limits[:email],
    error: company_field_error(record, :email)
  ) %>

  <%= render FlatPack::PhoneInput::Component.new(
    name: "company[phone]",
    value: record.phone,
    label: "Phone",
    maxlength: limits[:phone],
    error: company_field_error(record, :phone)
  ) %>

  <%= render FlatPack::DateInput::Component.new(
    name: "company[founded_on]",
    value: record.founded_on || record.founded_on_before_type_cast.presence,
    label: "Founded date",
    help_text: "Leave blank if you don't know it.",
    error: company_field_error(record, :founded_on)
  ) %>

  <div class="flex flex-wrap gap-3">
    <%= render FlatPack::Button::Component.new(text: submit_text, style: :primary, type: "submit") %>
    <%= render FlatPack::Button::Component.new(text: "Cancel", style: :ghost, href: cancel_url) %>
  </div>
<% end %>

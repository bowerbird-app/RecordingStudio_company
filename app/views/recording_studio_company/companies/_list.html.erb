<%# locals: (parent:, companies:, trashed_companies:) %>
<%= render FlatPack::Grid::Component.new(cols: 2, align: :start) do %>
<div>
<% if companies.any? %>
  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body(padding: :none) do %>
      <%= render FlatPack::List::Component.new(divider: true) do %>
        <% companies.each do |company| %>
          <%= render FlatPack::List::Item.new(
            href: company_path(company),
            hover: true,
            link_arguments: { class: "items-center" }
          ) do %>
            <%= company.recordable.name %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <%= render FlatPack::EmptyState::Component.new(
    title: t("recording_studio.company.empty.no_companies_title"),
    description: t("recording_studio.company.empty.no_companies_description", name: parent.name)
  ) %>
<% end %>

<% if trashed_companies.any? %>
  <%= render FlatPack::SectionTitle::Component.new(
    title: t("recording_studio.company.trash.section_title"),
    subtitle: t("recording_studio.company.trash.section_subtitle")
  ) %>
  <%= render FlatPack::List::Component.new(divider: true) do %>
    <% trashed_companies.each do |company| %>
      <%= render FlatPack::List::Item.new do %>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <%= link_to company.recordable.name, company_path(company), class: "font-medium" %>
          <% if company_can?(:restore, company) %>
            <%= form_with url: restore_company_path(company), method: :post, class: "inline-flex" do %>
              <%= render FlatPack::Button::Component.new(
                text: t("recording_studio.company.actions.restore"),
                style: :secondary,
                size: :sm,
                type: "submit",
                aria: { label: t("recording_studio.company.actions.restore_aria", name: company.recordable.name) }
              ) %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
</div>
<% end %>

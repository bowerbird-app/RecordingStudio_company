<%# locals: (parent:, company:) %>
<% if company %>
  <% name = company.recordable.name %>
  <%= render FlatPack::Alert::Component.new(
    style: :warning,
    title: t("recording_studio.company.trash.in_trash_title", name: name),
    description: t(
      "recording_studio.company.trash.vacancy_description",
      type: parent.type_label.downcase,
      name: name
    )
  ) %>
  <div class="flex flex-wrap gap-3">
    <% if company_can?(:restore, company) %>
      <%= form_with url: restore_company_path(company), method: :post, class: "inline-flex" do %>
        <%= render FlatPack::Button::Component.new(
          text: t("recording_studio.company.actions.restore_company"),
          style: :primary,
          type: "submit"
        ) %>
      <% end %>
    <% end %>
    <%= render FlatPack::Button::Component.new(
      text: t("recording_studio.company.actions.view_company"),
      style: :secondary,
      href: company_path(company)
    ) %>
  </div>
<% else %>
  <%= render FlatPack::EmptyState::Component.new(
    title: t("recording_studio.company.empty.no_company_title"),
    description: t("recording_studio.company.empty.no_company_description", type: parent.type_label.downcase)
  ) %>
<% end %>

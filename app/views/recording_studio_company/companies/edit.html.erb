<% name = @company.recordable.name %>
<% content_for :title, t("recording_studio.company.titles.edit") %>
<% content_for :subtitle, name %>
<% flat_pack_page_nav(round: true, style: :default) do |nav| %>
  <% nav.with_back(
    href: company_path(@company),
    tooltip: t("recording_studio.company.navigation.back")
  ) %>
<% end %>

<div class="flex w-full flex-col gap-6">
  <%= render "logo_field", company: @company %>

  <%= render "form",
             record: @record,
             url: company_path(@company),
             form_method: :patch,
             submit_text: t("recording_studio.company.actions.save"),
             unsaved_changes: true,
             delete_url: (company_path(@company) if company_can?(:trash, @company)),
             cancel_url: company_path(@company) %>
</div>

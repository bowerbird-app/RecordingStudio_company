<% home_path = company_home_path %>
<% content_for :title, @error_title %>
<% flat_pack_page_nav(round: true, style: :default) do |nav| %>
  <% nav.with_back(href: home_path, tooltip: t("recording_studio.company.navigation.home")) if home_path %>
<% end %>

<%= render FlatPack::EmptyState::Component.new(title: @error_title, description: @error_description) %>

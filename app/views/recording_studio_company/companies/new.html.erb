<% content_for :title, t("recording_studio.company.titles.add") %>
<% content_for :subtitle, company_parent_subtitle(@parent) %>
<% flat_pack_page_nav(round: true, style: :default) do |nav| %>
  <% nav.with_back(
    href: recording_companies_path(@parent),
    tooltip: t("recording_studio.company.navigation.back")
  ) %>
<% end %>

<div class="flex w-full flex-col gap-6">
  <%= render "form",
             record: @record,
             url: recording_companies_path(@parent),
             form_method: :post,
             idempotency_key: @idempotency_key,
             submit_text: t("recording_studio.company.actions.add_company"),
             cancel_url: recording_companies_path(@parent) %>

  <p class="text-sm text-(--surface-muted-content-color)"><%= t("recording_studio.company.new.logo_hint") %></p>
</div>

<% name = @company.recordable.name %>
<% parent = @company.parent_recording %>
<% can_update = company_can?(:update, @company) %>
<% can_trash = company_can?(:trash, @company) %>
<% recording_studio_page_nav(
  title: name,
  page_nav_back_url: recording_companies_path(@company.parent_recording_id),
  page_nav_back_label: "Back"
) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: name,
    subtitle: (company_parent_subtitle(parent) if parent)
  ) do |page_title| %>
    <% if can_update || can_trash %>
      <% page_title.slot do %>
        <% if can_update %>
          <%= render FlatPack::Button::Component.new(
            text: "Edit company",
            style: :primary,
            href: edit_company_path(@company)
          ) %>
        <% end %>
        <% if can_trash %>
          <%= form_with url: company_path(@company), method: :delete, class: "inline-flex" do %>
            <%= render FlatPack::Button::Component.new(text: "Move to trash", style: :secondary, type: "submit") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if @company.trashed_at %>
    <%= render FlatPack::Alert::Component.new(
      style: :warning,
      title: "#{name} is in the trash",
      description: "Restore it to change it again."
    ) %>
    <% if company_can?(:restore, @company) %>
      <%= form_with url: restore_company_path(@company), method: :post, class: "inline-flex" do %>
        <%= render FlatPack::Button::Component.new(text: "Restore company", style: :primary, type: "submit") %>
      <% end %>
    <% end %>
  <% end %>

  <%= recording_studio_company_card(@company) %>
</div>

<% dummy_page_nav(title: "Company demo", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Company demo",
    subtitle: "A press centre holds one company, an agency holds many, and a project inside the agency holds one.",
    variant: :h1
  ) %>

  <% if @company_parents.empty? %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No demo records yet",
      description: "Run bin/rails db:seed to add the Nike Newsroom press centre, the Northwind agency, and its Harbour fit-out project."
    ) %>
  <% else %>
    <div class="grid gap-6 lg:grid-cols-3">
      <% @company_parents.each do |parent| %>
        <% many = RecordingStudioCompany.allowance(parent) == :many %>
        <% companies = RecordingStudioCompany.companies(parent) %>
        <% place = parent.parent_recording ? "#{parent.type_label} in #{parent.parent_recording.name}" : parent.type_label %>
        <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
          <% card.header do %>
            <%= render FlatPack::PageTitle::Component.new(
              title: parent.name,
              subtitle: "#{place} · #{many ? 'many companies' : 'one company'}",
              variant: :h3,
              class: "mb-0 pb-0"
            ) %>
          <% end %>

          <% card.body do %>
            <% if companies.any? %>
              <ul class="space-y-3 text-sm">
                <% companies.each do |company| %>
                  <li class="flex items-center gap-3">
                    <%= recording_studio_company_logo(company, size: :sm) %>
                    <%= link_to company.recordable.name, recording_studio_company.company_path(company), class: "font-medium" %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p class="text-sm text-(--surface-muted-content-color)">No company yet.</p>
            <% end %>
          <% end %>

          <% card.footer do %>
            <%= render FlatPack::Button::Component.new(
              text: many ? "Open company list" : "Open company",
              style: :primary,
              href: recording_studio_company.recording_companies_path(parent)
            ) %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
